# Variant 1 — Debian slim, multi-stage, non-root.

# ---- Stage 1: builder (has pip and build tooling) ----
FROM python:3.13-slim AS builder
WORKDIR /build
COPY requirements.txt .
# Install dependencies into an isolated folder we can copy as a single unit.
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---- Stage 2: runtime ----
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Create an unprivileged system user with a fixed UID (predictable for K8s securityContext).
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home app

WORKDIR /srv
COPY --from=builder /install /usr/local
COPY --chown=app:app app/ ./app/

# Everything after this line — including the running container — uses the unprivileged user.
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
