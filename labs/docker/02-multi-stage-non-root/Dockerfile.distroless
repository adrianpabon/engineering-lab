# Variant 3 — Google distroless (no shell, no pip, no package manager), non-root by default.

# ---- Stage 1: builder ----
# Python minor version MUST match the distroless runtime (debian13 ships Python 3.13).
FROM python:3.13-slim AS builder
WORKDIR /build
COPY requirements.txt .
# --target puts packages in a plain folder we can add to PYTHONPATH (distroless has no site-packages of ours).
RUN pip install --no-cache-dir --target=/install -r requirements.txt

# ---- Stage 2: runtime ----
# :nonroot tag already runs as UID 65532 ("nonroot"); no useradd possible — there is no shell.
FROM gcr.io/distroless/python3-debian13:nonroot
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/srv/deps

WORKDIR /srv
COPY --from=builder /install ./deps
COPY app/ ./app/

EXPOSE 8000
# Image ENTRYPOINT is python3, so CMD holds only its arguments. Exec form → uvicorn is PID 1.
CMD ["-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
